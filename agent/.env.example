# Copy this file to .env and fill in your own values. Never commit .env.

# From LiveKit Cloud: Settings -> API Keys
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# From Google AI Studio: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Optional: override the Gemini Live model (leave empty to use the plugin default)
GEMINI_LIVE_MODEL=
