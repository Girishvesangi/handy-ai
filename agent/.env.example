# Copy this file to .env and fill in your own values. Never commit .env.

# From LiveKit Cloud: Settings -> API Keys
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# From Google AI Studio: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Optional overrides (leave empty for the defaults)
GEMINI_LIVE_MODEL=        # default: gemini-3.8-live
CHECKER_MODEL=            # default: gemini-3.8-flash
EMBED_MODEL=              # default: gemini-embedding-001
WATCH_INTERVAL_S=         # seconds between background step checks, default 8 (0 = off)
WARN_CONFIDENCE=          # how sure the checker must be before interrupting, default 0.75
POINTER_AUTO=             # draw a box around the part to touch at each new step, default 1 (0 = only on request)

# Optional: send traces to Langfuse (https://langfuse.com) for a per-session timeline
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=            # default: https://cloud.langfuse.com
